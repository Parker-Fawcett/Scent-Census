{
  "name": "scentcensus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "prisma migrate deploy && vitest run --config vitest.integration.config.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts --env-file=.env",
    "ingest:catalog": "npm run ingest:fragrantica --",
    "ingest:fragrantica": "tsx scripts/ingest-fragrantica.ts --env-file=.env",
    "test:e2e": "DATABASE_URL=postgresql://scent:scent-test@localhost:5545/scent_test npx prisma migrate deploy && playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "script": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
