// Scent Census data model. Contract source: docs/PRD-v1.md section 9.
// Every relation mirrors the PRD; the catalogueSourcePid columns keep the
// FragDB stable IDs for refresh joins without letting source keys become ours.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HouseTier {
  DESIGNER
  NICHE
  CLONE
  MASS_MARKET
}

enum NotePosition {
  TOP
  HEART
  BASE
  // community note rows the corpus ships untiered (flat); honest position
  ANY
}

enum Concentration {
  OIL
  EDC
  EDT
  EDP
  EXTRAIT
  OTHER
}

enum VoteDirection {
  LIKE
  DISLIKE
  DECLINE
  OWN
}

enum CensusBucket {
  SPOT_ON
  CLOSE
  SIMILAR
  SAME_FAMILY
  NOT_CLOSE
}

enum CreatorStatus {
  UNCLAIMED
  INVITED
  CLAIMED
  VERIFIED
}

enum SubjectType {
  FRAGRANCE
  HOUSE
  CREATOR
}

enum UpdateEventType {
  DROP
  NEW_REVIEW
  PICKUP
  CENSUS_MILESTONE
  WORTH_MOVE
  STATUS_CHANGE
}

enum PriceSource {
  EBAY_ASKING
  RETAIL_FEED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  // onboarding taste answers (PRD section 7.1); nullable so skipping is legal
  budgetBand    String?
  cloneBand     String?
  accordPrefs   String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  collectionItems CollectionItem[]
  votes           Vote[]
  // last shown feed page (PRD 7.3 back-to-back rule); one state per user
  feedPageState   FeedPageState?
  cloneVotes      CloneVote[]
  follows         Follow[]
  updateEvents    UpdateEvent[]
  catalogueRequests CatalogueRequest[]
  claimedCreator  Creator?
  accounts        Account[]
  sessions        Session[]
}

// Auth.js adapter storage (next-auth v5). Credentials users live in User
// itself (passwordHash); Google/others land here.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model House {
  id                 String     @id @default(cuid())
  name               String     @unique
  slug               String     @unique
  tier               HouseTier
  // Stable id from the catalogue source (FragDB brand id) for refresh joins.
  catalogueSourcePid String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  fragrances Fragrance[]
}

model Note {
  id     String @id @default(cuid())
  name   String @unique
  family String

  fragranceNotes FragranceNote[]
}

model Fragrance {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  houseId        String
  house          House          @relation(fields: [houseId], references: [id])
  concentration  Concentration?
  year           Int?
  // community accord names ordered by vote strength (strongest first);
  // provenance is the corpus snapshot, so nothing is curated here
  accords        String[]   @default([])
  // denormalized note names (sorted by pyramid weight) so catalogue search
  // never joins FragranceNote at query time (PRD 7.1 perf)
  noteNames      String[]   @default([])
  discontinued   Boolean        @default(false)
  perfumer       String?
  blindBuyRisk   Float?
  // clone-of edge (PRD section 9): null for originals
  inspiredById   String?
  inspiredBy     Fragrance?     @relation("CloneOf", fields: [inspiredById], references: [id])
  inspiredClones Fragrance[]    @relation("CloneOf")
  // stable FragDB pid for release diffs and refresh joins
  catalogueSourcePid String? @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notes             FragranceNote[]
  collectionItems   CollectionItem[]
  votes             Vote[]
  pricePoints       PricePoint[]
  estimate          FragranceEstimate?
  cloneVotesAsClone CloneVote[]        @relation("CloneVoteClone")
  cloneVotesAsTarget CloneVote[]       @relation("CloneVoteTarget")
  creatorPickups    CreatorPickup[]
  rollupsAsClone    CloneRollup[]      @relation("RollupClone")
  rollupsAsTarget   CloneRollup[]      @relation("RollupTarget")
  // curated census coverage: EVERY approved clone-of pair (a famous clone
  // shares neighborhood comparisons), canon stays on inspiredById above
  inspiredEdgesAsClone  InspiredByEdge[] @relation("InspiredEdgeClone")
  inspiredEdgesAsTarget InspiredByEdge[] @relation("InspiredEdgeTarget")
}

model FragranceNote {
  fragranceId String
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  noteId      String
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  position    NotePosition
  // FragDB pyramid weight/opacity, 0..1
  weight      Float     @default(0.5)

  @@id([fragranceId, noteId, position])
}

// What the user last saw on their feed page: fragranceId -> reason slug, so
// the PRD 7.3 rule (no fragrance back-to-back with the same reason across
// pages) survives reloads without client-side state.
model FeedPageState {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shownRecently Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CatalogueRequest {
  id            String   @id @default(cuid())
  // nullable so non-users can request too; users get status visibility
  requestedById String?
  requestedBy   User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  name          String
  houseGuess    String?
  // if the request matched a known FragDB pid, it ingests directly
  sourcePid     String?
  status        String   @default("open") // open | added | rejected
  createdAt     DateTime @default(now())
}

model CollectionItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragranceId    String
  fragrance      Fragrance @relation(fields: [fragranceId], references: [id])
  sizeMl         Int?
  batchCode      String?
  pricePaidCents Int?
  purchasedOn    DateTime?
  sealed         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Vote {
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragranceId String
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id])
  direction   VoteDirection
  // which reason line was visible when the vote happened (PRD section 7.3)
  reasonSlug  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([userId, fragranceId])
  @@index([fragranceId])
}

model PricePoint {
  id              String      @id @default(cuid())
  fragranceId     String
  fragrance       Fragrance   @relation(fields: [fragranceId], references: [id])
  source          PriceSource
  sizeMl          Int?
  condition       String?
  priceCents      Int
  capturedAt      DateTime
  sourceListingId String?

  @@index([fragranceId, capturedAt])
}

model FragranceEstimate {
  fragranceId String    @id
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id])
  lowCents    Int
  midCents    Int
  highCents   Int
  sampleSize  Int
  computedAt  DateTime
  isStale     Boolean   @default(false)
  // previous band is retained on recompute so worth-move events diff against
  // something real instead of remembering it elsewhere (PRD 7.7 signal 4)
  previousLowCents  Int?
  previousHighCents Int?
  previousComputedAt DateTime?
}

model CloneVote {
  userId   String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cloneId  String
  clone    Fragrance @relation("CloneVoteClone", fields: [cloneId], references: [id])
  targetId String
  target   Fragrance @relation("CloneVoteTarget", fields: [targetId], references: [id])
  bucket   CensusBucket
  votedAt  DateTime @default(now())

  @@unique([userId, cloneId, targetId])
  @@index([cloneId, targetId])
}

model CloneRollup {
  id         String    @id @default(cuid())
  cloneId    String
  clone      Fragrance @relation("RollupClone", fields: [cloneId], references: [id])
  targetId   String
  target     Fragrance @relation("RollupTarget", fields: [targetId], references: [id])
  score      Int
  sampleSize Int
  computedAt DateTime
  isStale    Boolean   @default(false)

  @@unique([cloneId, targetId])
}

// Curated census coverage: one row per approved clone->original pair. The
// canon edge (inspiredById) stays single-valued for display and the feed
// pools; this table carries the full neighborhood so a target's census lists
// every clone the curation approves, not only one flagship.
model InspiredByEdge {
  cloneId   String
  clone     Fragrance @relation("InspiredEdgeClone", fields: [cloneId], references: [id], onDelete: Cascade)
  targetId  String
  target    Fragrance @relation("InspiredEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([cloneId, targetId])
  @@index([targetId])
}

// Creator accounts are claim-based (PRD section 7.7): we invite, they claim.
// Fragrence never runs fan pages.
model Creator {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  platforms   Json
  status      CreatorStatus @default(UNCLAIMED)
  claimedById String?       @unique
  claimedBy   User?         @relation(fields: [claimedById], references: [id])
  bio         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  pickups     CreatorPickup[]
}

model Follow {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectType     SubjectType
  subjectId       String
  // guards double-emitting drop and review events
  lastSeenRelease String?
  createdAt       DateTime    @default(now())

  @@unique([userId, subjectType, subjectId])
  @@index([subjectType, subjectId])
}

model CreatorPickup {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  fragranceId String
  fragrance   Fragrance @relation(fields: [fragranceId], references: [id])
  kind        String   @default("review") // review | pickup
  url         String
  title       String?
  createdAt   DateTime @default(now())

  @@index([fragranceId])
  @@index([creatorId])
}

model UpdateEvent {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        UpdateEventType
  subjectType SubjectType
  subjectId   String
  payload     Json
  occurredAt  DateTime
  emittedAt   DateTime        @default(now())
  sourceLabel String
  // optional dedup identity for milestone events; the unique index below
  // makes concurrent emissions collapse instead of duplicating
  dedupKey    String?

  // feed fetch is "latest for this user"; index serves it, sort at query time
  @@index([userId])
  @@unique([userId, type, subjectType, subjectId, dedupKey])
}
